# Bid Studio Configuration
APP_NAME="Bid Studio"
APP_ENV="development"
DATABASE_URL="sqlite:///./bid_studio.db"
DEFAULT_WORKSPACE_SLUG="primus-demo"
DIGEST_SENDER_EMAIL="digest@bidstudio.example"
DELIVERY_SENDER_EMAIL="delivery@bidstudio.example"
SEED_ON_STARTUP="true"

# Automation
CONTACT_NOTIFY_EMAIL="team@bidstudio.example"
# Protects /api/v1/automation/run; Vercel cron sends it automatically as a Bearer token
CRON_SECRET=""
# Draft and queue every open funding call in the default workspace on each scheduled run
AUTO_PROCESS_GRANTS="false"
REMINDER_WINDOW_DAYS="14"
# Leave SMTP_HOST empty to only log emails; set it to actually send them
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_STARTTLS="true"
