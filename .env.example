# Bid Studio Configuration
APP_NAME="Bid Studio"
APP_ENV="development"
DATABASE_URL="sqlite:///./bid_studio.db"
DEFAULT_WORKSPACE_SLUG="primus-demo"
DIGEST_SENDER_EMAIL="digest@bidstudio.example"
DELIVERY_SENDER_EMAIL="delivery@bidstudio.example"
SEED_ON_STARTUP="true"

# Automation
CONTACT_NOTIFY_EMAIL="team@bidstudio.example"
# Protects /api/v1/automation/run; Vercel cron sends it automatically as a Bearer token
CRON_SECRET=""
# Draft and queue every open funding call in the default workspace on each scheduled run
AUTO_PROCESS_GRANTS="false"
REMINDER_WINDOW_DAYS="14"
# Leave SMTP_HOST empty to only log emails; set it to actually send them
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_STARTTLS="true"

# Grants feed: sources refreshed on each scheduled run (grants_gov, eu_funding). Empty = manual sync only
FEED_SOURCES=""
FEED_SYNC_LIMIT="50"

# AI assistant in the Grant Studio. Leave the key empty to use the offline rule-based helper.
# With a key, the section text and funder context are sent to the Anthropic API.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-sonnet-5-5"

# Licensing (see README). off = no checks, warn = banner only, on = block until a valid key is installed
LICENSE_ENFORCEMENT="off"
# Paste the key you were issued here, or activate it in the app at /app/license
LICENSE_KEY=""
# Vendor public key (base64url) printed by `python -m bid_studio.tools.license_admin keygen`
LICENSE_PUBLIC_KEY=""
LICENSE_GRACE_DAYS="14"
# Comma-separated key ids to refuse (revocation)
LICENSE_REVOKED_IDS=""
